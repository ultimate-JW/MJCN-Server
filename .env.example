# MJCN 백엔드 환경변수 템플릿 (spec 8.5).
# 실제 값은 .env (gitignore)에 넣고 본 파일은 키 이름만 노출용으로 커밋한다.

# ─── Django 기본 ──────────────────────────────────────
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=

# ─── DB (spec 8.5) ────────────────────────────────────
# 운영: DB_ENGINE=postgresql + 아래 5개 키 필수
# 로컬: DB_ENGINE 미지정 시 SQLite 폴백
DB_ENGINE=postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# ─── Email (spec 5.1.1·5.1.4) ─────────────────────────
# EMAIL_HOST_USER 미지정 시 콘솔 백엔드로 폴백 (로컬 개발용)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ─── OpenAI (spec 9.1·5.2) ────────────────────────────
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_NOTICE_CONTENT_MAX_CHARS=4000
# OPENAI_REQUEST_TIMEOUT=30
# OPENAI_MAX_RETRIES=3
# OPENAI_VLM_MAX_IMAGES=5
# OPENAI_CHAT_CONTEXT_MESSAGES=10

# ─── 카카오 OAuth (spec 5.1.3) ────────────────────────
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# ─── Firebase / FCM (spec 9.3) ────────────────────────
# 미설정 시 send_pending_pushes는 graceful no-op
FIREBASE_CREDENTIALS_PATH=

# ─── S3 미디어 저장소 (PR #92, spec 5.2.4 follow-up) ───
# 운영에서만 USE_S3=True. 로컬은 미설정 또는 False → MEDIA_ROOT 폴백
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-northeast-2
